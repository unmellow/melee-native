# Wii U GameCube controller adapter — unprivileged hidraw access.
# Install: sudo cp native/udev/51-gcadapter.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="0337", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="0337", MODE="0666"
